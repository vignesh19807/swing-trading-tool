# ==============================================================================
# Swing Trading Intelligence Platform — Master Environment Configuration
# ==============================================================================
#
# INSTRUCTIONS:
#   This template documents all environment variables across backend and frontend.
#   Never commit actual .env, .env.local, or secrets to Git.
#
# ==============================================================================

# --- RUNTIME ENVIRONMENT ---
# Options: development, staging, production
# In production, DATABASE_URL is strictly required (managed Neon PostgreSQL).
ENVIRONMENT=development

# --- BACKEND SETTINGS ---
# Managed PostgreSQL connection string (Neon Serverless PostgreSQL 16)
# Required in production. In development, if unset, defaults to local SQLite.
# Example: postgresql://<user>:<password>@<ep-pooler-id>.ap-southeast-1.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
# DATABASE_URL=

# Database file location (SQLite). Used for local development and offline testing.
DATABASE_PATH=database/swing_trading.db

# Host interface and port
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Allowed frontend CORS origins (comma-separated, no trailing slash)
# Local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://swing-trading-tool.vercel.app

# Market configuration
HISTORY_YEARS=2
MARKET_TIMEZONE=Asia/Kolkata

# Administrative Security
# Required for universe administration endpoints (/api/universe/*).
# If unset, administrative write operations fail closed with HTTP 403.
ADMIN_API_KEY=replace-with-a-secure-random-secret-key

# --- FRONTEND SETTINGS ---
# Backend API base URL consumed by Vite (no trailing slash)
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Mock data mode (false for real backend data, true only for offline UI development)
VITE_USE_MOCK_DATA=false
