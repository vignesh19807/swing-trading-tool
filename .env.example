# ==============================================================================
# Swing Trading Intelligence Platform — Master Environment Configuration
# ==============================================================================
#
# INSTRUCTIONS:
#   This template documents all environment variables across backend and frontend.
#   Never commit actual .env, .env.local, or secrets to Git.
#
# ==============================================================================

# --- BACKEND SETTINGS ---
# Database file location (SQLite). Set to /data/swing_trading.db in persistent containers.
DATABASE_PATH=database/swing_trading.db

# Host interface and port
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Allowed frontend CORS origins (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Market configuration
HISTORY_YEARS=2
MARKET_TIMEZONE=Asia/Kolkata

# Administrative Security
# Required for universe administration endpoints (/api/universe/*).
# If unset, administrative write operations fail closed with HTTP 403.
ADMIN_API_KEY=replace-with-a-secure-random-secret-key

# --- FRONTEND SETTINGS ---
# Backend API base URL consumed by Vite (no trailing slash)
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Mock data mode (false for real backend data, true only for offline UI development)
VITE_USE_MOCK_DATA=false

