# ==============================================================================
# Swing Trading Intelligence Platform — Backend Environment Configuration
# ==============================================================================
#
# USAGE:
#   Copy this file to backend/.env for local overrides:
#     cp backend/.env.example backend/.env
#
#   backend/.env is gitignored and must NOT be committed to version control.
#   Never store secrets, passwords, or private keys in this file.
#
# ==============================================================================

# Runtime Environment Classification
# Options: development, staging, production
ENVIRONMENT=development

# Managed PostgreSQL Connection String (Neon PostgreSQL 16)
# Required in production. Fail-closed safety guard prevents SQLite fallback in production.
# Example: postgresql://<user>:<password>@<ep-pooler-id>.ap-southeast-1.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
# DATABASE_URL=

# Database File Path (SQLite)
# Used when DATABASE_URL is unset in development/testing mode.
# Local Development: database/swing_trading.db (relative to project root)
DATABASE_PATH=database/swing_trading.db

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins without trailing slashes.
# Local development defaults:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://swing-trading-tool.vercel.app

# Market & Historical Data Settings
HISTORY_YEARS=2
MARKET_TIMEZONE=Asia/Kolkata

# Administrative Security
# Required to perform administrative operations (stock onboarding, status updates, audit queries).
# If unset, administrative write operations fail closed with HTTP 403.
# Pass via X-API-Key header in requests.
ADMIN_API_KEY=replace-with-a-secure-random-secret-key
