# Swing Trading Intelligence Platform — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
#   - Never commit .env to version control (it is already in .gitignore)
#   - This file (.env.example) contains only placeholder values
#   - Replace placeholder values with real configuration before running
# ─────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API.
# This is a PLACEHOLDER — the actual backend port/host will be confirmed
# by the Backend API Engineer before Phase 2 integration begins.
# Default for local development:
VITE_API_BASE_URL=http://localhost:5000

# Set to 'true' to enable mock data mode during development.
# When true, service functions will return mock data instead of calling the API.
# MUST be 'false' or unset in production.
VITE_USE_MOCK_DATA=false
