# ==============================================================================
# Swing Trading Intelligence Platform — Frontend Environment Variables
# ==============================================================================
#
# USAGE:
#   Copy this file to .env.local for local development:
#     cp .env.example .env.local
#
#   .env.local is gitignored and must NOT be committed.
#   Never put real secrets in this file.
#
# VITE RULES:
#   Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# ==============================================================================

# Backend API base URL
# Required when VITE_USE_MOCK_DATA=false.
# If VITE_USE_MOCK_DATA is false and this variable is missing or empty,
# the application throws an explicit configuration error rather than silently falling back.
VITE_API_BASE_URL=http://localhost:5000

# Enable mock data for offline / test development
# Set to "true" only when you want to use src/data/ mock fixtures instead of
# real backend responses. Must be "false" (or absent) in production.
# Mock data MUST NOT silently replace failed API requests in real mode.
VITE_USE_MOCK_DATA=false

